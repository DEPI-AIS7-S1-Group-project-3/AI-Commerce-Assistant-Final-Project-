[
  {"id": 1, "case": "search with filters", "question": "عايز موبايل سامسونج تحت 15 ألف",
   "tool": "search_products",
   "args": {"category": "mobiles", "brand": "samsung", "max_price": 15000, "sort": "price_asc"},
   "expect": {"skus": ["MOB-SAM-D140-4-128", "MOB-SAM-D350-8-256"]}},
  {"id": 2, "case": "search with a price range", "question": "لابتوب ما بين 15 و 25 ألف، الأرخص الأول",
   "tool": "search_products",
   "args": {"category": "laptops", "min_price": 15000, "max_price": 25000, "sort": "price_asc"},
   "expect": {"skus": ["LAP-HP-H3-8-256", "LAP-LEN-L3-8-256", "LAP-LEN-L5R-8-512"]}},
  {"id": 3, "case": "spec filters", "question": "موبايل 5G رام 8 أو أكتر تحت 15 ألف",
   "tool": "search_products",
   "args": {"category": "mobiles", "max_price": 15000, "sort": "price_asc",
            "specs": {"ram_gb_min": 8, "network": "5g"}},
   "expect": {"skus": ["MOB-REA-P9-8-128", "MOB-XIA-D14Plus-8-256", "MOB-SAM-D350-8-256"]}},
  {"id": 4, "case": "sort by a spec", "question": "إيه أقوى بطارية في الموبايلات؟",
   "tool": "search_products",
   "args": {"category": "mobiles", "sort_spec": "battery_mah", "limit": 2},
   "expect": {"skus": ["MOB-XIA-P7Pro-12-512", "MOB-XIA-D14Plus-8-256"]}},
  {"id": 5, "case": "true/false spec filter", "question": "عايز سماعة بعزل ضوضاء",
   "tool": "search_products",
   "args": {"category": "audio", "specs": {"noise_cancelling": true}, "sort": "price_asc"},
   "expect": {"skus": ["AUD-ANK-S3", "AUD-BAS-B9", "AUD-BAS-H9", "AUD-JBL-E7"]}},
  {"id": 6, "case": "two minimum spec filters", "question": "لابتوب رام 16 وبطاريته 10 ساعات على الأقل",
   "tool": "search_products",
   "args": {"category": "laptops", "sort": "price_asc",
            "specs": {"ram_gb_min": 16, "battery_hours_min": 10}},
   "expect": {"skus": ["LAP-DEL-DL7-16-1024", "LAP-ASU-AU7-16-512", "LAP-DEL-DX9-32-1024"]}},
  {"id": 7, "case": "out-of-stock product is hidden by default", "question": "عندكم ريلمي C5؟",
   "tool": "search_products",
   "args": {"brand": "realme", "max_price": 5000},
   "expect": {"empty": true}},
  {"id": 8, "case": "out-of-stock product when asked", "question": "طيب ريلمي C5 حتى لو مش متاح",
   "tool": "search_products",
   "args": {"brand": "realme", "max_price": 5000, "in_stock_only": false},
   "expect": {"skus": ["MOB-REA-C5-4-64"], "products.0.in_stock": "False"}},
  {"id": 9, "case": "details of an out-of-stock product", "question": "تفاصيل سماعة انكر S1",
   "tool": "product_get",
   "args": {"product_sku": "AUD-ANK-S1"},
   "expect": {"product.in_stock": "False", "product.stock_qty": "0"}},
  {"id": 10, "case": "empty result", "question": "عايز لابتوب أبل",
   "tool": "search_products",
   "args": {"category": "laptops", "brand": "apple"},
   "expect": {"empty": true, "count": 0}},
  {"id": 11, "case": "bad spec key", "question": "موبايل لونه أحمر",
   "tool": "search_products",
   "args": {"category": "mobiles", "specs": {"color": "red"}},
   "expect": {"error": "invalid_spec_filter"}},
  {"id": 12, "case": "product that does not exist", "question": "تفاصيل المنتج رقم 999999",
   "tool": "product_get",
   "args": {"product_id": 999999},
   "expect": {"error": "product_not_found"}},
  {"id": 13, "case": "compare, with one id that does not exist",
   "question": "قارنلي شاومي D14 Plus وسامسونج D350 والمنتج 999999",
   "tool": "products_compare",
   "args": {"product_skus": ["MOB-XIA-D14Plus-8-256", "MOB-SAM-D350-8-256"], "extra_ids": [999999]},
   "expect": {"skus": ["MOB-XIA-D14Plus-8-256", "MOB-SAM-D350-8-256"], "missing_ids": [999999]}},
  {"id": 14, "case": "reviews summary", "question": "الناس بتقول إيه عن أوبو A60؟",
   "tool": "reviews_summary_get",
   "args": {"product_sku": "MOB-OPP-A60-6-128"},
   "expect": {"rating_count": 5, "rating_avg": "2.80", "positive_count": 1, "negative_count": 2}},
  {"id": 15, "case": "categories and brands", "question": "إيه الماركات والأقسام اللي عندكم؟",
   "tool": "categories_brands_list",
   "args": {},
   "expect": {"category_slugs": ["mobiles", "laptops", "audio"], "brand_count": 12}}
]
