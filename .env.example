DATABASE_URL=postgresql+psycopg://app:app_dev_password@localhost:5432/ai_commerce
JWT_SECRET="dev-only-change-me-not-for-production-use"
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
ENV=development

# LLM: ordered list, first = primary, the rest = fallbacks (gemini, groq, xai, openrouter, openai, anthropic)
# (openrouter: its free model slug was withdrawn, so it is off by default; set LLM_MODELS if you add it)
LLM_PROVIDERS=gemini,groq
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# XAI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# LLM_GEMINI_THINKING=auto
# ASSISTANT_RATE_LIMIT_PER_MINUTE=20   # messages per user (or IP) per minute for /assistant/chat; 0 = off
# ASSISTANT_DEBUG_TRACE=false   # true = /assistant/chat also returns the trace (development)
# LLM_MODELS={"gemini": "gemini-3-flash-preview"}
